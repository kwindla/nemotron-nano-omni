+    def _validate_conversation_cache_request(
+        self, request: ChatCompletionRequest
+    ) -> ErrorResponse | None:
+        if not request.conversation_id:
+            return None
+        if request.n not in (None, 1):
+            return self.create_error_response(
+                "conversation_id only supports n=1 in this implementation."
+            )
+        if request.use_beam_search:
+            return self.create_error_response(
+                "conversation_id does not support beam search in this implementation."
+            )
+        if request.continue_final_message:
+            return self.create_error_response(
+                "conversation_id does not support continue_final_message."
+            )
+        if not request.add_generation_prompt:
+            return self.create_error_response(
+                "conversation_id requires add_generation_prompt=true."
+            )
+        return None
+
+    def _prepare_conversation_render_request(
+        self,
+        request: ChatCompletionRequest,
+        lease: ConversationFrontendLease,
+    ) -> tuple[ChatCompletionRequest, list[Any]]:
+        suffix_messages = self._conversation_suffix_messages(request, lease)
+        if not lease.committed_messages:
+            return request, suffix_messages
+
+        render_messages = [
+            *copy.deepcopy(list(lease.committed_messages)),
+            *copy.deepcopy(suffix_messages),
+        ]
+        render_request = request.model_copy(update={"messages": render_messages})
+        logger.debug(
+            "Rendering conversation %s with %d committed messages and %d suffix "
+            "messages.",
+            lease.key.conversation_id,
+            len(lease.committed_messages),
+            len(suffix_messages),
+        )
+        return render_request, suffix_messages
+
+    def _conversation_suffix_messages(
+        self,
+        request: ChatCompletionRequest,
+        lease: ConversationFrontendLease,
+    ) -> list[Any]:
+        committed_count = lease.committed_message_count
+        if committed_count <= 0 or not lease.committed_messages:
+            return copy.deepcopy(request.messages)
+        if len(request.messages) > committed_count and self._looks_like_full_history(
+            request.messages,
+            lease.committed_messages,
+            committed_count,
+        ):
+            return copy.deepcopy(request.messages[committed_count:])
+        return copy.deepcopy(request.messages)
+
+    @staticmethod
+    def _looks_like_full_history(
+        messages: GenericSequence[Any],
+        committed_messages: GenericSequence[Any],
+        committed_count: int,
+    ) -> bool:
+        if len(committed_messages) < committed_count:
+            return False
+        for index in range(committed_count):
+            if OpenAIServingChat._message_role(messages[index]) != (
+                OpenAIServingChat._message_role(committed_messages[index])
+            ):
+                return False
+        return True
+
+    @staticmethod
+    def _message_role(message: Any) -> Any:
+        if isinstance(message, dict):
+            return message.get("role")
+        return getattr(message, "role", None)
