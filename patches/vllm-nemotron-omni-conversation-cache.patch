+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Literal
+
+if TYPE_CHECKING:
+    from vllm.v1.engine import FinishReason
+    from vllm.v1.request import Request
+
+
+@dataclass(frozen=True)
+class ConversationEngineCacheKey:
+    conversation_id: str
+    cache_salt: str = ""
+
+
+@dataclass(frozen=True)
+class ConversationMambaTerminalStateRef:
+    kv_cache_group_id: int
+    block_index: int
+    block_id: int
+
+
+@dataclass(frozen=True)
+class ConversationMambaTerminalCapture:
+    request_id: str
+    kv_cache_group_id: int
+    src_block_index: int
+    dst_block_index: int
+    accept_token_bias: int
+
+
+@dataclass(frozen=True)
+class ConversationBlockCopy:
+    request_id: str
+    kv_cache_group_id: int
+    src_block_id: int
+    dst_block_id: int
+    kind: Literal["full_attention_tail", "mamba_terminal"]
+
+
+@dataclass
+class ConversationEngineState:
+    """Engine-owned exact conversation ledger.
+
+    This phase intentionally records only token/request metadata. Later phases
+    will add full-attention block ownership and terminal Mamba state locations.
+    """
+
+    key: ConversationEngineCacheKey
+    generation_id: str
+    token_count: int
+    committed_token_ids: tuple[int, ...]
+    prompt_token_ids: tuple[int, ...]
+    output_token_ids: tuple[int, ...]
+    finish_reason: str | None
+    stop_reason: int | str | None
+    block_refs_by_group: tuple[tuple[Any, ...], ...] = ()
+    mamba_terminal_state_refs: tuple[ConversationMambaTerminalStateRef, ...] = ()
+    created_at: float = field(default_factory=time.monotonic)
+    last_access: float = field(default_factory=time.monotonic)
+    completed_generations: int = 0
+
+
+@dataclass
+class PendingConversationEngineState:
+    key: ConversationEngineCacheKey
+    previous_generation_id: str | None
+    pending_generation_id: str
+    old_state: ConversationEngineState | None
+    new_state: ConversationEngineState
+    created_at: float = field(default_factory=time.monotonic)
+    last_access: float = field(default_factory=time.monotonic)
+
+
+@dataclass(frozen=True)
+class ConversationCacheMutation:
+    ok: bool
+    release_states: tuple[ConversationEngineState, ...] = ()
+
+
+class ConversationEngineCache:
+    """Process-local exact conversation cache state for the v1 engine.
+
+    This manager does not use vLLM's block-prefix-cache matching. It is a
+    complete-turn state machine that later code can extend with physical KV and
+    Mamba ownership once copy-on-write attach/capture is implemented.
+    """
+
+    def __init__(self, pending_ttl_seconds: float = 300.0) -> None:
+        self.pending_ttl_seconds = pending_ttl_seconds
+        self._committed: dict[ConversationEngineCacheKey, ConversationEngineState] = {}
+        self._pending: dict[
+            ConversationEngineCacheKey, PendingConversationEngineState
+        ] = {}
+
+    def stage(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        token_ids: list[int] | tuple[int, ...],
+        prompt_token_ids: list[int] | tuple[int, ...],
+        output_token_ids: list[int] | tuple[int, ...],
+        finish_reason: str | "FinishReason" | None,
+        stop_reason: int | str | None,
+        block_refs_by_group: tuple[tuple[Any, ...], ...] = (),
+        mamba_terminal_state_refs: tuple[ConversationMambaTerminalStateRef, ...] = (),
+        now: float | None = None,
+    ) -> ConversationEngineState | None:
+        now = time.monotonic() if now is None else now
+        self.expire_pending(now=now)
+        key = self.make_key(conversation_id, cache_salt)
+        if key in self._pending:
+            return None
+
+        old_state = self._committed.get(key)
+        new_state = ConversationEngineState(
+            key=key,
+            generation_id=generation_id,
+            token_count=len(token_ids),
+            committed_token_ids=tuple(token_ids),
+            prompt_token_ids=tuple(prompt_token_ids),
+            output_token_ids=tuple(output_token_ids),
+            finish_reason=self._finish_reason_to_str(finish_reason),
+            stop_reason=stop_reason,
+            block_refs_by_group=block_refs_by_group,
+            mamba_terminal_state_refs=mamba_terminal_state_refs,
+            created_at=now,
+            last_access=now,
+            completed_generations=(old_state.completed_generations if old_state else 0),
+        )
+        self._pending[key] = PendingConversationEngineState(
+            key=key,
+            previous_generation_id=old_state.generation_id if old_state else None,
+            pending_generation_id=generation_id,
+            old_state=old_state,
+            new_state=new_state,
+            created_at=now,
+            last_access=now,
+        )
+        return new_state
+
+    def stage_from_request(
+        self,
+        request: "Request",
+        *,
+        finish_reason: str | "FinishReason" | None,
+        block_refs_by_group: tuple[tuple[Any, ...], ...] = (),
+        mamba_terminal_state_refs: tuple[ConversationMambaTerminalStateRef, ...] = (),
+        now: float | None = None,
+    ) -> ConversationEngineState | None:
+        if not request.conversation_id or not request.conversation_generation_id:
+            return None
+        return self.stage(
+            conversation_id=request.conversation_id,
+            cache_salt=request.cache_salt,
+            generation_id=request.conversation_generation_id,
+            token_ids=tuple(request.all_token_ids),
+            prompt_token_ids=tuple(request.prompt_token_ids or ()),
+            output_token_ids=tuple(request.output_token_ids),
+            finish_reason=finish_reason,
+            stop_reason=request.stop_reason,
+            block_refs_by_group=block_refs_by_group,
+            mamba_terminal_state_refs=mamba_terminal_state_refs,
+            now=now,
+        )
+
+    def publish(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        now: float | None = None,
+    ) -> bool:
+        return self.publish_with_released(
+            conversation_id=conversation_id,
+            cache_salt=cache_salt,
+            generation_id=generation_id,
+            now=now,
+        ).ok
+
+    def publish_with_released(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        now: float | None = None,
+    ) -> ConversationCacheMutation:
+        now = time.monotonic() if now is None else now
+        expired = self.expire_pending_with_released(now=now).release_states
+        key = self.make_key(conversation_id, cache_salt)
+        pending = self._pending.get(key)
+        if pending is None or pending.pending_generation_id != generation_id:
+            return ConversationCacheMutation(False, expired)
+
+        new_state = pending.new_state
+        new_state.completed_generations += 1
+        new_state.last_access = now
+        self._committed[key] = new_state
+        del self._pending[key]
+        release_states = expired
+        if pending.old_state is not None:
+            release_states = (*release_states, pending.old_state)
+        return ConversationCacheMutation(True, release_states)
+
+    def discard_pending(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        now: float | None = None,
+    ) -> bool:
+        return self.discard_pending_with_released(
+            conversation_id=conversation_id,
+            cache_salt=cache_salt,
+            generation_id=generation_id,
+            now=now,
+        ).ok
+
+    def discard_pending_with_released(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        now: float | None = None,
+    ) -> ConversationCacheMutation:
+        now = time.monotonic() if now is None else now
+        expired = self.expire_pending_with_released(now=now).release_states
+        key = self.make_key(conversation_id, cache_salt)
+        pending = self._pending.get(key)
+        if pending is None or pending.pending_generation_id != generation_id:
+            return ConversationCacheMutation(False, expired)
+        del self._pending[key]
+        return ConversationCacheMutation(True, (*expired, pending.new_state))
+
+    def touch_pending(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        generation_id: str,
+        now: float | None = None,
+    ) -> bool:
+        now = time.monotonic() if now is None else now
+        self.expire_pending(now=now)
+        key = self.make_key(conversation_id, cache_salt)
+        pending = self._pending.get(key)
+        if pending is None or pending.pending_generation_id != generation_id:
+            return False
+        pending.last_access = now
+        pending.new_state.last_access = now
+        return True
+
+    def delete(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        now: float | None = None,
+    ) -> bool:
+        return self.delete_with_released(
+            conversation_id=conversation_id,
+            cache_salt=cache_salt,
+            now=now,
+        ).ok
+
+    def delete_with_released(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+        now: float | None = None,
+    ) -> ConversationCacheMutation:
+        now = time.monotonic() if now is None else now
+        expired = self.expire_pending_with_released(now=now).release_states
+        key = self.make_key(conversation_id, cache_salt)
+        if key in self._pending:
+            return ConversationCacheMutation(False, expired)
+        committed = self._committed.pop(key, None)
+        if committed is None:
+            return ConversationCacheMutation(False, expired)
+        return ConversationCacheMutation(True, (*expired, committed))
+
+    def get_committed(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+    ) -> ConversationEngineState | None:
+        key = self.make_key(conversation_id, cache_salt)
+        state = self._committed.get(key)
+        if state is not None:
+            state.last_access = time.monotonic()
+        return state
+
+    def get_pending(
+        self,
+        *,
+        conversation_id: str,
+        cache_salt: str | None,
+    ) -> PendingConversationEngineState | None:
+        return self._pending.get(self.make_key(conversation_id, cache_salt))
+
+    def expire_pending(self, *, now: float | None = None) -> int:
+        return len(self.expire_pending_with_released(now=now).release_states)
+
+    def expire_pending_with_released(
+        self,
+        *,
+        now: float | None = None,
+    ) -> ConversationCacheMutation:
+        if self.pending_ttl_seconds <= 0:
+            return ConversationCacheMutation(True)
+        now = time.monotonic() if now is None else now
+        expired = [
+            key
+            for key, pending in self._pending.items()
+            if now - pending.last_access > self.pending_ttl_seconds
+        ]
+        release_states = tuple(self._pending[key].new_state for key in expired)
+        for key in expired:
+            del self._pending[key]
+        return ConversationCacheMutation(True, release_states)
+
+    @staticmethod
+    def make_key(
+        conversation_id: str,
+        cache_salt: str | None,
+    ) -> ConversationEngineCacheKey:
+        return ConversationEngineCacheKey(
+            conversation_id=conversation_id,
+            cache_salt=cache_salt or "",
+        )
+
+    @staticmethod
+    def _finish_reason_to_str(reason: Any) -> str | None:
+        if reason is None:
+            return None
+        value = getattr(reason, "value", reason)
+        return str(value)
