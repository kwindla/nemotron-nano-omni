+def test_conversation_engine_cache_release_candidates():
+    cache = ConversationEngineCache(pending_ttl_seconds=5.0)
+    refs_1 = (("block-a",),)
+    refs_2 = (("block-b",),)
+    refs_3 = (("block-c",),)
+
+    first = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-1",
+        token_ids=[1],
+        prompt_token_ids=[1],
+        output_token_ids=[],
+        finish_reason="stop",
+        stop_reason=None,
+        block_refs_by_group=refs_1,
+        now=10.0,
+    )
+    assert first is not None
+    publish_1 = cache.publish_with_released(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-1",
+        now=11.0,
+    )
+    assert publish_1.ok
+    assert publish_1.release_states == ()
+
+    second = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-2",
+        token_ids=[1, 2],
+        prompt_token_ids=[1],
+        output_token_ids=[2],
+        finish_reason="stop",
+        stop_reason=None,
+        block_refs_by_group=refs_2,
+        now=12.0,
+    )
+    assert second is not None
+    publish_2 = cache.publish_with_released(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-2",
+        now=13.0,
+    )
+    assert publish_2.ok
+    assert publish_2.release_states == (first,)
+
+    third = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-3",
+        token_ids=[1, 2, 3],
+        prompt_token_ids=[1],
+        output_token_ids=[2, 3],
+        finish_reason="stop",
+        stop_reason=None,
+        block_refs_by_group=refs_3,
+        now=14.0,
+    )
+    assert third is not None
+    discard = cache.discard_pending_with_released(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-3",
+        now=15.0,
+    )
+    assert discard.ok
+    assert discard.release_states == (third,)
+
+    delete = cache.delete_with_released(
+        conversation_id="conv",
+        cache_salt=None,
+        now=16.0,
+    )
+    assert delete.ok
+    assert delete.release_states == (second,)
+
+    expired = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-expire",
+        token_ids=[4],
+        prompt_token_ids=[4],
+        output_token_ids=[],
+        finish_reason="stop",
+        stop_reason=None,
+        block_refs_by_group=refs_1,
+        now=20.0,
+    )
+    assert expired is not None
+    expiration = cache.expire_pending_with_released(now=26.0)
+    assert expiration.ok
+    assert expiration.release_states == (expired,)
+
