+def test_conversation_full_attention_block_ref_helpers():
+    spec = FullAttentionSpec(
+        block_size=4,
+        num_kv_heads=1,
+        head_size=8,
+        dtype=torch.float16,
+    )
+    manager = KVCacheManager(
+        kv_cache_config=KVCacheConfig(
+            num_blocks=8,
+            kv_cache_tensors=[],
+            kv_cache_groups=[
+                KVCacheGroupSpec(layer_names=["layer.0"], kv_cache_spec=spec)
+            ],
+        ),
+        max_model_len=16,
+        hash_block_size=4,
+        max_num_batched_tokens=16,
+        enable_caching=False,
+    )
+    request = Request(
+        request_id="req-1",
+        prompt_token_ids=[1, 2, 3, 4, 5],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    manager.allocate_slots(request, num_new_tokens=request.num_tokens)
+
+    refs = manager.get_block_refs_by_group(request.request_id)
+    assert len(refs) == 1
+    assert [block.block_id for block in refs[0]] == [1, 2]
+    assert [block.ref_cnt for block in refs[0]] == [1, 1]
+
+    forgotten = manager.forget_request_blocks(request.request_id)
+    assert forgotten == refs
+    assert manager.get_blocks(request.request_id).blocks[0] == ()
+    assert [block.ref_cnt for block in refs[0]] == [1, 1]
+
+    request_2 = Request(
+        request_id="req-2",
+        prompt_token_ids=[1, 2, 3, 4, 5, 6],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    attached = manager.attach_existing_blocks(request_2.request_id, refs)
+    assert attached.get_block_ids() == ([1, 2],)
+    assert [block.ref_cnt for block in refs[0]] == [2, 2]
+
+    manager.release_block_refs_by_group(refs)
+    assert [block.ref_cnt for block in refs[0]] == [1, 1]
+
+    request_2.status = RequestStatus.FINISHED_STOPPED
+    manager.free(request_2)
+    assert [block.ref_cnt for block in refs[0]] == [0, 0]
+
