+                    for block_id in src_block_ids
+                    for offset in range(block_ratio)
+                ]
+                dst_block_ids = [
+                    block_id * block_ratio + offset
+                    for block_id in dst_block_ids
+                    for offset in range(block_ratio)
+                ]
+
+            src_indices = torch.tensor(
