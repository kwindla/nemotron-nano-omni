+@pytest.mark.asyncio
+async def test_conversation_frontend_cache_busy_and_publish():
+    cache = ConversationFrontendCache()
+
+    lease = await cache.try_acquire(
+        model="model",
+        cache_salt=None,
+        conversation_id="conv",
+        generation_id="gen-1",
+    )
+    assert lease is not None
+
+    busy = await cache.try_acquire(
+        model="model",
+        cache_salt=None,
+        conversation_id="conv",
+        generation_id="gen-2",
+    )
+    assert busy is None
+
+    await cache.publish(
+        lease,
+        assistant_text="hello",
+        committed_messages=[
+            {"role": "user", "content": "hi"},
+            {"role": "assistant", "content": "hello"},
+        ],
+        committed_prompt_token_ids=[1, 2, 3],
+    )
+
+    entry = cache.get_entry(model="model", cache_salt=None, conversation_id="conv")
+    assert entry is not None
+    assert entry.committed_message_count == 2
+    assert entry.committed_messages == (
+        {"role": "user", "content": "hi"},
+        {"role": "assistant", "content": "hello"},
+    )
+    assert entry.committed_prompt_token_ids == (1, 2, 3)
+    assert entry.committed_text == "hello"
+    assert entry.completed_generations == 1
+
+    lease_2 = await cache.try_acquire(
+        model="model",
+        cache_salt=None,
+        conversation_id="conv",
+        generation_id="gen-2",
+    )
+    assert lease_2 is not None
+    assert lease_2.committed_message_count == 2
+    assert lease_2.committed_messages == entry.committed_messages
+    assert lease_2.committed_prompt_token_ids == (1, 2, 3)
+    await cache.discard(lease_2)
+
