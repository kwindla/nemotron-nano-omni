+def test_conversation_engine_cache_publish_discard_delete_and_ttl():
+    cache = ConversationEngineCache(pending_ttl_seconds=5.0)
+
+    staged = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-1",
+        token_ids=[1, 2, 3],
+        prompt_token_ids=[1, 2],
+        output_token_ids=[3],
+        finish_reason="stop",
+        stop_reason=None,
+        now=10.0,
+    )
+    assert staged is not None
+    assert staged.token_count == 3
+    assert staged.completed_generations == 0
+
+    assert not cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-busy",
+        token_ids=[1],
+        prompt_token_ids=[1],
+        output_token_ids=[],
+        finish_reason="stop",
+        stop_reason=None,
+        now=11.0,
+    )
+    assert cache.touch_pending(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-1",
+        now=12.0,
+    )
+    assert cache.publish(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-1",
+        now=13.0,
+    )
+
+    committed = cache.get_committed(conversation_id="conv", cache_salt=None)
+    assert committed is not None
+    assert committed.generation_id == "gen-1"
+    assert committed.completed_generations == 1
+
+    staged_2 = cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-2",
+        token_ids=[1, 2, 3, 4],
+        prompt_token_ids=[1, 2, 3],
+        output_token_ids=[4],
+        finish_reason="length",
+        stop_reason=None,
+        now=14.0,
+    )
+    assert staged_2 is not None
+    assert staged_2.completed_generations == 1
+    assert cache.discard_pending(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-2",
+        now=15.0,
+    )
+    assert cache.get_committed(conversation_id="conv", cache_salt=None) is committed
+
+    assert cache.delete(conversation_id="conv", cache_salt=None, now=16.0)
+    assert cache.get_committed(conversation_id="conv", cache_salt=None) is None
+
+    assert cache.stage(
+        conversation_id="conv",
+        cache_salt=None,
+        generation_id="gen-expire",
+        token_ids=[1],
+        prompt_token_ids=[1],
+        output_token_ids=[],
+        finish_reason="stop",
+        stop_reason=None,
+        now=20.0,
+    )
+    assert cache.expire_pending(now=26.0) == 1
+    assert cache.get_pending(conversation_id="conv", cache_salt=None) is None
