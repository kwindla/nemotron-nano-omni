+                KVCacheGroupSpec(layer_names=["mamba.0"], kv_cache_spec=mamba_spec),
+            ],
+        ),
+        max_model_len=16,
+        hash_block_size=4,
+        max_num_batched_tokens=16,
+        enable_caching=False,
+    )
+    request = Request(
+        request_id="req-hybrid-cow-1",
+        prompt_token_ids=[1, 2, 3, 4, 5],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    manager.allocate_slots(request, num_new_tokens=request.num_tokens)
+    manager.take_new_block_ids()
+    refs = manager.get_block_refs_by_group(request.request_id)
+    mamba_refs = manager.get_mamba_terminal_state_block_refs(
+        request.request_id,
+        token_count=request.num_tokens,
+    )
+    manager.forget_request_blocks(request.request_id)
+
+    request_2 = Request(
+        request_id="req-hybrid-cow-2",
+        prompt_token_ids=[1, 2, 3, 4, 5, 6],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    attached, copies = manager.attach_conversation_blocks_copy_on_write(
+        request_2.request_id,
