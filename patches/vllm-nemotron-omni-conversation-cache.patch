+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import time
+from collections.abc import AsyncGenerator, Awaitable, Callable, Sequence
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any
+
+
+class ConversationCacheState(Enum):
+    READY = "ready"
+    GENERATING = "generating"
+    FAILED = "failed"
+
+
+@dataclass(frozen=True)
+class ConversationCacheKey:
+    model: str
+    cache_salt: str
+    conversation_id: str
+
+
+@dataclass
+class ConversationFrontendEntry:
+    key: ConversationCacheKey
+    state: ConversationCacheState = ConversationCacheState.READY
+    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
+    generation_id: str | None = None
+    committed_message_count: int = 0
+    committed_messages: tuple[Any, ...] = ()
+    committed_prompt_token_ids: tuple[int, ...] | None = None
+    committed_text: str = ""
+    created_at: float = field(default_factory=time.time)
+    last_access: float = field(default_factory=time.time)
+    completed_generations: int = 0
+
+
+@dataclass(frozen=True)
+class ConversationFrontendLease:
+    key: ConversationCacheKey
+    generation_id: str
+    committed_message_count: int = 0
+    committed_messages: tuple[Any, ...] = ()
+    committed_prompt_token_ids: tuple[int, ...] | None = None
+
+
+@dataclass(frozen=True)
+class ConversationStreamingResult:
+    content: AsyncGenerator[str, None]
+    on_close: Callable[[], Awaitable[None]]
+
+
+class ConversationFrontendCache:
+    """Process-local OpenAI-layer ledger for exact conversation cache state.
+
+    It provides the request contract, same-id exclusion, and committed turn
+    message ledger used to reconstruct suffix-only append requests before they
+    reach the engine-owned KV/Mamba cache.
+    """
+
+    def __init__(self) -> None:
+        self._entries: dict[ConversationCacheKey, ConversationFrontendEntry] = {}
+        self._guard = asyncio.Lock()
+
+    async def try_acquire(
+        self,
+        *,
+        model: str,
+        cache_salt: str | None,
+        conversation_id: str,
+        generation_id: str,
+    ) -> ConversationFrontendLease | None:
+        key = self._make_key(model, cache_salt, conversation_id)
+        async with self._guard:
+            entry = self._entries.get(key)
+            if entry is None:
+                entry = ConversationFrontendEntry(key=key)
+                self._entries[key] = entry
+
+            if entry.state is not ConversationCacheState.READY or entry.lock.locked():
+                return None
+
+            await entry.lock.acquire()
+            entry.state = ConversationCacheState.GENERATING
+            entry.generation_id = generation_id
+            entry.last_access = time.time()
+            return ConversationFrontendLease(
+                key=key,
+                generation_id=generation_id,
+                committed_message_count=entry.committed_message_count,
+                committed_messages=tuple(copy.deepcopy(entry.committed_messages)),
+                committed_prompt_token_ids=entry.committed_prompt_token_ids,
+            )
+
+    async def publish(
+        self,
+        lease: ConversationFrontendLease,
+        *,
+        assistant_text: str,
+        committed_message_count: int | None = None,
+        committed_messages: Sequence[Any] | None = None,
+        committed_prompt_token_ids: Sequence[int] | None = None,
+    ) -> None:
+        async with self._guard:
+            entry = self._entries.get(lease.key)
+            if entry is None or entry.generation_id != lease.generation_id:
+                return
+
+            if committed_messages is not None:
+                entry.committed_messages = tuple(copy.deepcopy(committed_messages))
+                entry.committed_message_count = len(entry.committed_messages)
+            elif committed_message_count is not None:
+                entry.committed_message_count = committed_message_count
+            if committed_prompt_token_ids is not None:
+                entry.committed_prompt_token_ids = tuple(committed_prompt_token_ids)
+            entry.committed_text = assistant_text
+            entry.completed_generations += 1
+            entry.state = ConversationCacheState.READY
+            entry.generation_id = None
+            entry.last_access = time.time()
+            if entry.lock.locked():
+                entry.lock.release()
+
+    async def discard(self, lease: ConversationFrontendLease) -> None:
+        async with self._guard:
+            entry = self._entries.get(lease.key)
+            if entry is None or entry.generation_id != lease.generation_id:
+                return
+
+            entry.state = ConversationCacheState.READY
+            entry.generation_id = None
+            entry.last_access = time.time()
+            if entry.lock.locked():
+                entry.lock.release()
+
+    def get_entry(
+        self,
+        *,
+        model: str,
+        cache_salt: str | None,
+        conversation_id: str,
+    ) -> ConversationFrontendEntry | None:
+        return self._entries.get(self._make_key(model, cache_salt, conversation_id))
+
+    @staticmethod
+    def _make_key(
+        model: str,
+        cache_salt: str | None,
+        conversation_id: str,
+    ) -> ConversationCacheKey:
+        return ConversationCacheKey(
+            model=model,
+            cache_salt=cache_salt or "",
+            conversation_id=conversation_id,
+        )
