+def test_conversation_full_attention_tail_copy_on_write_attach_helper():
+    spec = FullAttentionSpec(
+        block_size=4,
+        num_kv_heads=1,
+        head_size=8,
+        dtype=torch.float16,
+    )
+    manager = KVCacheManager(
+        kv_cache_config=KVCacheConfig(
+            num_blocks=8,
+            kv_cache_tensors=[],
+            kv_cache_groups=[
+                KVCacheGroupSpec(layer_names=["layer.0"], kv_cache_spec=spec)
+            ],
+        ),
+        max_model_len=16,
+        hash_block_size=4,
+        max_num_batched_tokens=16,
+        enable_caching=False,
+    )
+    request = Request(
+        request_id="req-cow-1",
+        prompt_token_ids=[1, 2, 3, 4, 5],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    manager.allocate_slots(request, num_new_tokens=request.num_tokens)
+    manager.take_new_block_ids()
+    refs = manager.get_block_refs_by_group(request.request_id)
+    assert [block.block_id for block in refs[0]] == [1, 2]
+    assert manager.forget_request_blocks(request.request_id) == refs
+
+    request_2 = Request(
+        request_id="req-cow-2",
+        prompt_token_ids=[1, 2, 3, 4, 5, 6],
+        sampling_params=SamplingParams(max_tokens=4),
+        pooling_params=None,
+    )
+    attached, copies = manager.attach_full_attention_blocks_copy_on_write(
+        request_2.request_id,
+        refs,
+        token_count=5,
+    )
+    assert attached.get_block_ids() == ([1, 3],)
+    assert copies == (
+        ConversationBlockCopy(
+            request_id=request_2.request_id,
+            kv_cache_group_id=0,
+            src_block_id=2,
+            dst_block_id=3,
+            kind="full_attention_tail",
+        ),
+    )
+    assert [block.ref_cnt for block in refs[0]] == [2, 1]
+
+    single_manager = manager.coordinator.single_type_managers[0]
+    assert single_manager.num_cached_block[request_2.request_id] == 1
+
+    new_block_ids = manager.take_new_block_ids()
+    assert new_block_ids == [3]
+
+    manager.release_block_refs_by_group(refs)
+    request_2_blocks = manager.get_block_refs_by_group(request_2.request_id)[0]
+    assert [block.block_id for block in request_2_blocks] == [1, 3]
+    assert [block.ref_cnt for block in refs[0]] == [1, 0]
+    assert [block.ref_cnt for block in request_2_blocks] == [1, 1]
+
+    request_2.status = RequestStatus.FINISHED_STOPPED
+    manager.free(request_2)
+    assert [block.ref_cnt for block in request_2_blocks] == [0, 0]
+
