+    @staticmethod
+    def _shared_prefix_token_count(
+        cached_token_ids: list[int] | tuple[int, ...],
+        request_token_ids: list[int] | tuple[int, ...],
+    ) -> int:
+        shared = 0
+        for cached_token_id, request_token_id in zip(
+            cached_token_ids,
+            request_token_ids,
+        ):
+            if cached_token_id != request_token_id:
+                break
+            shared += 1
+        return shared
+
+    def _conversation_attachable_token_count(
+        self,
+        state: ConversationEngineState,
+        request: Request,
+    ) -> int:
+        prompt_token_ids = request.prompt_token_ids
+        if prompt_token_ids is None:
+            return 0
+        if state.token_count <= 0 or len(prompt_token_ids) < state.token_count:
+            return 0
+        if tuple(prompt_token_ids[: state.token_count]) != state.committed_token_ids:
+            return 0
+        return state.token_count
+
+    def _state_has_mamba_align_cache(self, state: ConversationEngineState) -> bool:
+        for group_id, manager in enumerate(
+            self.kv_cache_manager.coordinator.single_type_managers
+        ):
+            if not isinstance(getattr(manager, "kv_cache_spec", None), MambaSpec):
+                continue
+            if getattr(manager, "mamba_cache_mode", None) != "align":
+                continue
+            if group_id >= len(state.block_refs_by_group):
+                continue
+            if state.block_refs_by_group[group_id]:
+                return True
+        return False
