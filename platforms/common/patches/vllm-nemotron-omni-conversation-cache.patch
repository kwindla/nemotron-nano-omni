+                    await self._publish_conversation_response(
+                        lease,
+                        "".join(assistant_text_parts),
+                        assistant_tool_calls=(
+                            self._finalize_conversation_stream_tool_calls(
+                                assistant_tool_calls_by_index
+                            )
+                        ),
+                        committed_messages=committed_messages,
+                        committed_prompt_token_ids=committed_prompt_token_ids,
+                        committed_checkpoint_token_count=(
+                            committed_checkpoint_token_count
+                        ),
+                        suffix_messages=suffix_messages,
+                        prompt_token_ids=prompt_token_ids,
+                    )
+                    lease_finalized = True
+                yield chunk
+
+            if lease_finalized:
+                return
+            if saw_done and not saw_error:
+                await self._publish_conversation_response(
+                    lease,
+                    "".join(assistant_text_parts),
+                    assistant_tool_calls=(
+                        self._finalize_conversation_stream_tool_calls(
+                            assistant_tool_calls_by_index
