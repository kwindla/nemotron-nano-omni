+_TRACE_NAME_RE = re.compile(r"[^A-Za-z0-9._-]")
+
+
+def _trace_json_value(value: Any) -> Any:
+    if hasattr(value, "model_dump"):
+        return _trace_json_value(value.model_dump(mode="json"))
+    if isinstance(value, dict):
+        if (
+            set(value.keys()) == {"url"}
+            and isinstance(value["url"], str)
+            and value["url"].startswith("data:audio/")
+        ):
+            url = value["url"]
+            _, _, encoded = url.partition(",")
+            digest = hashlib.sha256(encoded.encode("ascii")).hexdigest()
+            return {
+                "url": f"<data-audio-base64 sha256={digest} chars={len(encoded)}>",
+            }
+        return {str(key): _trace_json_value(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_trace_json_value(item) for item in value]
+    return value
+
+
+def _write_conversation_trace(
+    trace_id: str | None,
+    phase: str,
+    payload: dict[str, Any],
+) -> None:
+    trace_dir = os.getenv("VLLM_CONVERSATION_TRACE_DIR")
+    if not trace_dir or not trace_id:
+        return
+    try:
+        conversation_trace_dir = Path(trace_dir)
+        conversation_trace_dir.mkdir(parents=True, exist_ok=True)
+        safe_trace_id = _TRACE_NAME_RE.sub("_", Path(str(trace_id)).name)
+        safe_phase = _TRACE_NAME_RE.sub("_", Path(str(phase)).name)
+        if not safe_trace_id or not safe_phase:
+            return
+        trace_path = conversation_trace_dir / f"{safe_trace_id}.{safe_phase}.json"
+        trace_payload = {
+            "trace_id": trace_id,
+            "phase": phase,
+            "timestamp": time.time(),
+            **payload,
+        }
+        trace_path.write_text(
+            json.dumps(
+                _trace_json_value(trace_payload),
+                indent=2,
+                ensure_ascii=True,
+                sort_keys=True,
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+    except Exception as exc:
+        logger.warning(
+            "Failed to write conversation trace for %s phase %s: %s",
+            trace_id,
+            phase,
+            exc,
+        )
 
 
