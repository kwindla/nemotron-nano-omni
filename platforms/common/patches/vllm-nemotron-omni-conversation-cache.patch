+    def _prepare_conversation_render_request(
+        self,
+        request: ChatCompletionRequest,
+        lease: ConversationFrontendLease,
+    ) -> tuple[ChatCompletionRequest, list[Any]]:
+        if not request.conversation_require_cache:
+            return request, copy.deepcopy(list(request.messages))
+        suffix_messages = self._conversation_suffix_messages(request, lease)
+        if not lease.committed_messages:
+            return request, suffix_messages
+
+        render_messages = [
+            *copy.deepcopy(list(lease.committed_messages)),
+            *copy.deepcopy(suffix_messages),
+        ]
+        render_request = request.model_copy(update={"messages": render_messages})
+        logger.debug(
+            "Rendering conversation %s with %d committed messages and %d suffix "
+            "messages.",
+            lease.key.conversation_id,
+            len(lease.committed_messages),
+            len(suffix_messages),
+        )
+        return render_request, suffix_messages
+
+    def _conversation_suffix_messages(
+        self,
+        request: ChatCompletionRequest,
+        lease: ConversationFrontendLease,
+    ) -> list[Any]:
+        committed_count = lease.committed_message_count
+        if committed_count <= 0 or not lease.committed_messages:
+            return copy.deepcopy(request.messages)
+        if len(request.messages) >= committed_count and self._looks_like_full_history(
+            request.messages,
+            lease.committed_messages,
+            committed_count,
+        ):
+            return copy.deepcopy(request.messages[committed_count:])
+        return copy.deepcopy(request.messages)
+
+    @staticmethod
+    def _committable_messages_after_success(
+        messages: list[Any],
+        *,
+        committed_message_count: int | None = None,
+    ) -> list[Any]:
+        if committed_message_count is not None:
+            return copy.deepcopy(messages[:committed_message_count])
+
+        # Advance the durable conversation-cache boundary only through the
+        # latest user row. Rows after that user belong to the active assistant
+        # turn and may still be rewritten or removed by the client before the
+        # next user turn settles the transcript.
+        latest_user_index = -1
+        for index in range(len(messages) - 1, -1, -1):
+            if OpenAIServingChat._message_role(messages[index]) == "user":
+                latest_user_index = index
+                break
+        if latest_user_index < 0:
+            return copy.deepcopy(messages)
+        return copy.deepcopy(messages[: latest_user_index + 1])
+
+    @classmethod
+    def _looks_like_full_history(
+        cls,
+        messages: GenericSequence[Any],
+        committed_messages: GenericSequence[Any],
+        committed_count: int,
+    ) -> bool:
+        if len(messages) < committed_count or len(committed_messages) < committed_count:
+            return False
+        return all(
+            cls._normalized_message(messages[index])
+            == cls._normalized_message(committed_messages[index])
+            for index in range(committed_count)
+        )
+
+    @classmethod
+    def _normalized_message(cls, value: Any) -> Any:
+        if hasattr(value, "model_dump"):
+            return cls._normalized_message(value.model_dump(mode="json"))
+        if isinstance(value, dict):
+            return {
+                str(key): cls._normalized_message(item)
+                for key, item in sorted(value.items(), key=lambda pair: str(pair[0]))
+            }
+        if isinstance(value, (list, tuple)):
+            return [cls._normalized_message(item) for item in value]
+        return value
+
+    @staticmethod
+    def _message_role(message: Any) -> Any:
+        if isinstance(message, dict):
+            return message.get("role")
+        return getattr(message, "role", None)
+
+    def _filter_conversation_prefix_mm_inputs(
+        self,
+        engine_inputs: list[EngineInput],
+        lease: ConversationFrontendLease,
+    ) -> ErrorResponse | None:
+        if not lease.committed_prompt_token_ids:
+            return None
+
+        boundary = len(lease.committed_prompt_token_ids)
+        for index, engine_input in enumerate(engine_inputs):
+            filtered = self._filter_conversation_prefix_mm_input(
+                engine_input,
+                boundary,
+                conversation_id=lease.key.conversation_id,
+            )
+            if isinstance(filtered, ErrorResponse):
+                return filtered
+            engine_inputs[index] = filtered
+        return None
+
+    def _filter_conversation_prefix_mm_input(
+        self,
+        engine_input: EngineInput,
+        boundary: int,
+        *,
+        conversation_id: str,
+    ) -> EngineInput | ErrorResponse:
+        if engine_input.get("type") != "multimodal":
+            return engine_input
+
+        mm_engine_input = cast(MultiModalInput, engine_input)
+        mm_hashes = mm_engine_input["mm_hashes"]
+        mm_placeholders = mm_engine_input["mm_placeholders"]
+        mm_kwargs = mm_engine_input["mm_kwargs"]
+
+        kept_hashes: dict[str, list[str]] = {}
+        kept_placeholders: dict[str, list[Any]] = {}
+        kept_kwargs_data: dict[str, list[Any]] = {}
+        kept = 0
+        removed = 0
+
+        for modality, placeholders in mm_placeholders.items():
+            hashes = list(mm_hashes.get(modality, []))
+            kwargs_items = list(mm_kwargs.get(modality, []))
+            if len(hashes) != len(placeholders) or len(kwargs_items) != len(
+                placeholders
+            ):
+                return self.create_error_response(
+                    "conversation_id multimodal metadata is inconsistent for "
+                    f"{conversation_id!r}: modality={modality!r} placeholders="
+                    f"{len(placeholders)} hashes={len(hashes)} kwargs="
+                    f"{len(kwargs_items)}",
+                    param="messages",
+                )
+            filtered_hashes: list[str] = []
+            filtered_placeholders: list[Any] = []
+            filtered_kwargs: list[Any] = []
+            for item_index, placeholder in enumerate(placeholders):
+                start = placeholder.offset
+                end = placeholder.offset + placeholder.length
+                if end <= boundary:
+                    filtered_placeholders.append(placeholder)
+                    filtered_hashes.append(hashes[item_index])
+                    filtered_kwargs.append(None)
+                    removed += 1
+                    continue
+                if start >= boundary:
+                    filtered_placeholders.append(placeholder)
+                    filtered_hashes.append(hashes[item_index])
+                    filtered_kwargs.append(kwargs_items[item_index])
+                    kept += 1
+                    continue
+                return self.create_error_response(
+                    "conversation_id cached multimodal placeholder spans the "
+                    f"committed prefix boundary for {conversation_id!r}: "
+                    f"modality={modality!r} offset={start} length="
+                    f"{placeholder.length} boundary={boundary}",
+                    param="messages",
+                )
+
+            if filtered_placeholders:
+                kept_placeholders[modality] = filtered_placeholders
+                kept_hashes[modality] = filtered_hashes
+                kept_kwargs_data[modality] = filtered_kwargs
+
+        if removed == 0:
+            return engine_input
+
+        logger.debug(
+            "Filtered %d cached multimodal payload(s) for conversation %s; "
+            "kept %d suffix payload(s) and preserved %d placeholder "
+            "descriptor(s).",
+            removed,
+            conversation_id,
+            kept,
+            sum(len(items) for items in kept_kwargs_data.values()),
+        )
+
+        filtered_input = dict(mm_engine_input)
+        filtered_input["mm_hashes"] = kept_hashes
+        filtered_input["mm_placeholders"] = kept_placeholders
+        filtered_input["mm_kwargs"] = mm_kwargs.__class__(kept_kwargs_data)
+        return cast(EngineInput, filtered_input)
+
+    def _conversation_prompt_token_ids(
+        self,
+        engine_inputs: list[EngineInput],
+    ) -> tuple[int, ...] | None:
+        if not engine_inputs:
+            return None
+        token_ids = self._extract_prompt_components(engine_inputs[0]).token_ids
+        if token_ids is None:
+            return None
+        return tuple(token_ids)
+
+    async def _render_conversation_prompt_token_ids(
+        self,
+        request: ChatCompletionRequest,
+        messages: GenericSequence[Any],
+        *,
+        add_generation_prompt: bool,
+    ) -> tuple[int, ...] | None:
+        render_request = request.model_copy(
+            update={
+                "messages": copy.deepcopy(list(messages)),
+                "add_generation_prompt": add_generation_prompt,
+            }
+        )
+        try:
+            result = await self.openai_serving_render.render_chat(
+                render_request,
+                skip_mm_cache=True,
+            )
+        except Exception:
+            logger.warning(
+                "Conversation render helper failed for conversation %s.",
+                request.conversation_id,
+                exc_info=True,
+            )
+            return None
+        if isinstance(result, ErrorResponse):
+            logger.warning(
+                "Conversation render helper returned an error for conversation %s: %s",
+                request.conversation_id,
+                result,
+            )
+            return None
+        _, engine_inputs = result
+        return self._conversation_prompt_token_ids(engine_inputs)
+
+    @staticmethod
+    def _conversation_exact_prefix_ok(
+        conversation_prompt_token_ids: GenericSequence[int] | None,
+        committed_prompt_token_ids: GenericSequence[int] | None,
+    ) -> bool:
+        committed = tuple(committed_prompt_token_ids or ())
+        if not committed or conversation_prompt_token_ids is None:
+            return False
+        if len(conversation_prompt_token_ids) < len(committed):
+            return False
+        return tuple(conversation_prompt_token_ids[: len(committed)]) == committed
+
+    @staticmethod
+    def _strip_conversation_engine_metadata(
